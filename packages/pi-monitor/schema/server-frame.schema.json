{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "ready"
        },
        "collectorEpoch": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "version",
        "type",
        "collectorEpoch"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "ack"
        },
        "collectorEpoch": {
          "$ref": "#/$defs/__schema0"
        },
        "eventIds": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "version",
        "type",
        "collectorEpoch",
        "eventIds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "reject"
        },
        "code": {
          "type": "string",
          "enum": [
            "unauthorized",
            "forbidden",
            "unsupported_version",
            "invalid_frame"
          ]
        }
      },
      "required": [
        "version",
        "type",
        "code"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
